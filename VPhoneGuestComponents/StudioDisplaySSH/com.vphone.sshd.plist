<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key><string>com.vphone.sshd</string>
    <key>ProgramArguments</key><array>
        <string>/usr/local/libexec/vphone-ssh/sshd</string>
        <string>-F</string>
        <string>-D</string><string>/private/var/db/vphone-ssh</string>
        <string>-r</string><string>/private/var/db/vphone-ssh/host_ed25519</string>
        <string>-p</string><string>127.0.0.1:2222</string>
        <string>-P</string><string>/private/var/db/vphone-ssh/sshd.pid</string>
    </array>
    <key>KeepAlive</key><dict><key>PathState</key><dict>
        <key>/private/var/db/vphone-ssh/authorized_keys</key><true/>
    </dict></dict>
    <key>UserName</key><string>root</string>
    <key>StandardErrorPath</key><string>/private/var/log/vphone-ssh.log</string>
    <key>ProcessType</key><string>Interactive</string>
    <key>ThrottleInterval</key><integer>5</integer>
</dict></plist>
